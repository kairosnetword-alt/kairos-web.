<script>
/* ============ CONFIGURA AQUÍ TUS DATOS ============ */
const KAIROS = {
  ip: "",                                             // IP del servidor, por ejemplo: "jugar.tuserver.com" (vacío = "Próximamente")
  version: "Java Edition",                            // por ejemplo: "Java 1.21"
  discord: "https://discord.gg/QAzEX8xwYT",           // invitación de tu Discord
  formulario: ""                                      // enlace del formulario de staff (vacío = "Formulario próximamente")
};
/* ================================================== */

const hasIp = !!KAIROS.ip;
document.querySelectorAll("[data-cfg]").forEach(el => {
  const v = KAIROS[el.dataset.cfg];
  el.textContent = (el.dataset.cfg === "ip" && !hasIp) ? "Próximamente" : v;
});
document.querySelectorAll("[data-cfg-href]").forEach(el => {
  const k = el.dataset.cfgHref, v = KAIROS[k];
  if (v) { el.href = v; return; }
  el.removeAttribute("href"); el.classList.add("off"); el.setAttribute("aria-disabled","true");
  if (k === "formulario") el.textContent = "Formulario próximamente";
});
if (!hasIp) document.querySelectorAll("[data-copy]").forEach(b => { b.disabled = true; b.lastChild.textContent = "IP próximamente"; });

/* copiar IP */
document.querySelectorAll("[data-copy]").forEach(btn => {
  const original = btn.innerHTML;
  btn.addEventListener("click", async () => {
    try { await navigator.clipboard.writeText(KAIROS.ip); }
    catch (e) {
      const t = document.createElement("textarea"); t.value = KAIROS.ip; document.body.appendChild(t);
      t.select(); document.execCommand("copy"); t.remove();
    }
    btn.textContent = "IP copiada";
    setTimeout(() => btn.innerHTML = original, 1800);
  });
});

/* estado en vivo (solo si ya pusiste tu IP) */
(async () => {
  if (!hasIp) return;
  const box = document.getElementById("ipbox"), estado = document.getElementById("estado"), jug = document.getElementById("jugadores");
  try {
    const r = await fetch("https://api.mcsrvstat.us/3/" + encodeURIComponent(KAIROS.ip));
    const d = await r.json();
    if (d.online) {
      box.classList.add("online"); estado.textContent = "Servidor en línea";
      jug.textContent = d.players ? d.players.online + " de " + d.players.max + " jugadores" : "En línea";
    } else {
      box.classList.add("offline"); estado.textContent = "Servidor fuera de línea"; jug.textContent = "Ahora mismo no hay jugadores.";
    }
  } catch (e) { /* si falla, se deja el texto por defecto */ }
})();

/* barra superior sólida al bajar */
const nav = document.getElementById("nav");
const onScroll = () => nav.classList.toggle("solid", window.scrollY > 40);
onScroll(); addEventListener("scroll", onScroll, {passive:true});
</script>
</body>
